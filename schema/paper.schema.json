{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "paper",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "source",
    "level",
    "subject",
    "title",
    "mcq",
    "cq"
  ],
  "properties": {
    "id": {
      "$ref": "#/$defs/slug"
    },
    "source": {
      "$ref": "#/$defs/source"
    },
    "level": {
      "$ref": "#/$defs/level"
    },
    "subject": {
      "$ref": "#/$defs/slug"
    },
    "title": {
      "$ref": "#/$defs/bi"
    },
    "mcq": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "cq": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "$defs": {
    "bi": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bn",
        "en"
      ],
      "properties": {
        "bn": {
          "type": "string"
        },
        "en": {
          "type": "string"
        }
      }
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "level": {
      "enum": [
        "ssc",
        "hsc"
      ]
    },
    "figure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "file",
        "alt"
      ],
      "properties": {
        "file": {
          "type": "string",
          "pattern": "^figures/[a-z0-9-]+\\.(svg|png)$"
        },
        "alt": {
          "$ref": "#/$defs/bi"
        }
      }
    },
    "source": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "const": "original"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "exam",
            "board",
            "year"
          ],
          "properties": {
            "kind": {
              "const": "board"
            },
            "exam": {
              "$ref": "#/$defs/level"
            },
            "board": {
              "$ref": "#/$defs/slug"
            },
            "year": {
              "type": "integer",
              "minimum": 2015,
              "maximum": 2026
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "category",
            "institution",
            "session"
          ],
          "properties": {
            "kind": {
              "const": "admission"
            },
            "category": {
              "enum": [
                "medical",
                "engineering",
                "varsity"
              ]
            },
            "institution": {
              "$ref": "#/$defs/slug"
            },
            "session": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}$"
            },
            "unit": {
              "type": "string"
            }
          }
        }
      ]
    }
  }
}