{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cq-file",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "level",
    "subject",
    "chapter",
    "questions"
  ],
  "properties": {
    "level": {
      "$ref": "#/$defs/level"
    },
    "subject": {
      "$ref": "#/$defs/slug"
    },
    "chapter": {
      "$ref": "#/$defs/slug"
    },
    "questions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "topics",
          "difficulty",
          "source",
          "status",
          "stimulus",
          "parts"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$"
          },
          "topics": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/$defs/slug"
            }
          },
          "difficulty": {
            "enum": [
              "easy",
              "medium",
              "hard"
            ]
          },
          "source": {
            "$ref": "#/$defs/source"
          },
          "status": {
            "enum": [
              "draft",
              "checked",
              "reviewed"
            ]
          },
          "figures": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/figure"
            }
          },
          "stimulus": {
            "$ref": "#/$defs/bi"
          },
          "parts": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "ka",
              "kha",
              "ga",
              "gha"
            ],
            "properties": {
              "ka": {
                "$ref": "#/$defs/part"
              },
              "kha": {
                "$ref": "#/$defs/part"
              },
              "ga": {
                "$ref": "#/$defs/part"
              },
              "gha": {
                "$ref": "#/$defs/part"
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "bi": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bn",
        "en"
      ],
      "properties": {
        "bn": {
          "type": "string"
        },
        "en": {
          "type": "string"
        }
      }
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "level": {
      "enum": [
        "ssc",
        "hsc"
      ]
    },
    "figure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "file",
        "alt"
      ],
      "properties": {
        "file": {
          "type": "string",
          "pattern": "^figures/[a-z0-9-]+\\.(svg|png)$"
        },
        "alt": {
          "$ref": "#/$defs/bi"
        }
      }
    },
    "source": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "const": "original"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "exam",
            "board",
            "year"
          ],
          "properties": {
            "kind": {
              "const": "board"
            },
            "exam": {
              "$ref": "#/$defs/level"
            },
            "board": {
              "$ref": "#/$defs/slug"
            },
            "year": {
              "type": "integer",
              "minimum": 2015,
              "maximum": 2026
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "category",
            "institution",
            "session"
          ],
          "properties": {
            "kind": {
              "const": "admission"
            },
            "category": {
              "enum": [
                "medical",
                "engineering",
                "varsity"
              ]
            },
            "institution": {
              "$ref": "#/$defs/slug"
            },
            "session": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}$"
            },
            "unit": {
              "type": "string"
            }
          }
        }
      ]
    },
    "part": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "question",
        "solution"
      ],
      "properties": {
        "question": {
          "$ref": "#/$defs/bi"
        },
        "solution": {
          "$ref": "#/$defs/bi"
        }
      }
    }
  }
}