---
import Base from '../../../layouts/Base.astro';
import { MockExam } from '../../../components/MockExam';
import { readManifests } from '../../../lib/site-data';
import { UI } from '../../../lib/labels';
import type { SubjectManifest } from '../../../lib/types';

export function getStaticPaths() {
  return readManifests().map((m) => ({ params: { level: m.level, subject: m.subject }, props: { manifest: m } }));
}

const { manifest } = Astro.props as { manifest: SubjectManifest };
const level = manifest.level === 'ssc' ? { bn: 'এসএসসি', en: 'SSC' } : { bn: 'এইচএসসি', en: 'HSC' };
---

<Base title={`${UI.mockTitle.en}: ${level.en} ${manifest.title.en} · ${UI.mockTitle.bn}`} current="mock">
  <div class="page-head narrow">
    <h1>
      <span class="bn">{UI.mockTitle.bn}: {level.bn} {manifest.title.bn}</span>
      <span class="en">{UI.mockTitle.en}: {level.en} {manifest.title.en}</span>
    </h1>
  </div>
  <div class="narrow">
    <MockExam client:load manifest={manifest} />
  </div>
</Base>
