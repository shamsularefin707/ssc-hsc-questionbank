---
import Base from '../../../layouts/Base.astro';
import { QuestionBank } from '../../../components/QuestionBank';
import { readManifests } from '../../../lib/site-data';
import { UI } from '../../../lib/labels';
import type { SubjectManifest } from '../../../lib/types';

export function getStaticPaths() {
  return readManifests().map((m) => ({ params: { level: m.level, subject: m.subject }, props: { manifest: m } }));
}

const { manifest } = Astro.props as { manifest: SubjectManifest };
const level = manifest.level === 'ssc' ? { bn: 'এসএসসি', en: 'SSC' } : { bn: 'এইচএসসি', en: 'HSC' };
---

<Base title={`${level.en} ${manifest.title.en} · ${level.bn} ${manifest.title.bn} প্রশ্নব্যাংক`} current="bank">
  <div class="page-head">
    <h1>
      <span class="bn">{level.bn} {manifest.title.bn}</span>
      <span class="en">{level.en} {manifest.title.en}</span>
    </h1>
    <div class="page-actions">
      <a class="btn" href={`/${manifest.level}/${manifest.subject}/build`}><span class="bn">{UI.buildTitle.bn}</span><span class="en">{UI.buildTitle.en}</span></a>
      <a class="btn" href={`/${manifest.level}/${manifest.subject}/mock`}><span class="bn">{UI.mockTitle.bn}</span><span class="en">{UI.mockTitle.en}</span></a>
    </div>
  </div>
  <QuestionBank client:load manifest={manifest} />
</Base>
