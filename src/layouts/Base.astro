---
import 'katex/dist/katex.min.css';
import '../styles/global.css';
import { LangToggle } from '../components/LangToggle';

interface Props {
  title: string;
  description?: string;
  current?: 'bank' | 'build' | 'mock' | 'board' | 'admission';
}
const { title, description = 'SSC ও HSC বিজ্ঞান বিভাগের সৃজনশীল ও বহুনির্বাচনি প্রশ্ন, সমাধানসহ।', current } = Astro.props;
const fonts =
  'https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;600&family=Noto+Sans+Bengali:wght@400;600&family=Noto+Serif+Bengali:wght@400;600&family=Source+Serif+4:wght@400;600&display=swap';
---

<!doctype html>
<html lang="bn">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href={fonts} />
    <script is:inline>
      try {
        var l = JSON.parse(localStorage.getItem('qb:lang'));
        if (l === 'en' || l === 'bn') document.documentElement.lang = l;
      } catch (e) {}
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main"><span class="bn">মূল অংশে যান</span><span class="en">Skip to content</span></a>
    <header class="site-header">
      <div class="container">
        <a class="site-name" href="/"><span class="bn">প্রশ্নব্যাংক</span><span class="en">Question Bank</span></a>
        <nav class="site-nav" aria-label="Main menu / প্রধান মেনু">
          <a href="/" aria-current={current === 'bank' ? 'page' : undefined}><span class="bn">প্রশ্নব্যাংক</span><span class="en">Question bank</span></a>
          <a href="/board" aria-current={current === 'board' ? 'page' : undefined}><span class="bn">বোর্ড প্রশ্ন</span><span class="en">Board questions</span></a>
          <a href="/admission" aria-current={current === 'admission' ? 'page' : undefined}><span class="bn">ভর্তি পরীক্ষা</span><span class="en">Admission</span></a>
        </nav>
        <LangToggle client:load />
      </div>
    </header>
    <main id="main" class="container">
      <slot />
    </main>
  </body>
</html>
